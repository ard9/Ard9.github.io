---
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import AreaChips from '../../components/AreaChips.astro';
import { config } from '../../lib/config';
import { getProjects } from '../../lib/utils';
const projects = await getProjects();
const { title, intro } = config.sections.projects;
---
<Base title={title} description={intro}>
  <header class="page-head wrap">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </header>
  <section class="wrap body">
    <AreaChips entries={projects} />
    {projects.length
      ? <ul class="list">{projects.map((p) => <ProjectRow project={p} showCover />)}</ul>
      : <p class="empty">No projects yet. Add a Markdown file to <code>content/projects/</code> and it will appear here.</p>}
    <p class="empty" data-empty hidden>No projects in this area yet.</p>
  </section>
</Base>
<script>import { setupFilters } from '../../scripts/filter'; setupFilters();</script>
<style>.body { padding-block: 2rem 1rem; } .body > .chips { margin-bottom: 1.75rem; }</style>
