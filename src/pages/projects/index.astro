---
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { config } from '../../lib/config';
import { getProjects } from '../../lib/utils';
const projects = await getProjects();
const counts = new Map<string, number>();
projects.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const { title, intro } = config.sections.projects;
---
<Base title={title} description={intro}>
  <header class="page-head wrap">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </header>
  <section class="wrap body">
    {tags.length > 1 && (
      <div class="filter" role="group" aria-label="Filter by tag">
        <button type="button" data-tag="" aria-pressed="true">All <span>{projects.length}</span></button>
        {tags.map(([t, n]) => <button type="button" data-tag={t} aria-pressed="false">{t} <span>{n}</span></button>)}
      </div>
    )}
    {projects.length
      ? <ul class="list" id="project-list">{projects.map((p) => <ProjectRow project={p} showCover />)}</ul>
      : <p class="empty">No projects yet. Add a Markdown file to <code>content/projects/</code> and it will appear here.</p>}
  </section>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter button')];
  const rows = [...document.querySelectorAll<HTMLElement>('#project-list > li')];
  buttons.forEach((b) => b.addEventListener('click', () => {
    const tag = b.dataset.tag;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    rows.forEach((r) => { r.hidden = !!tag && !(r.dataset.tags || '').split('|').includes(tag!); });
  }));
</script>

<style>
  .body { padding-block: 2.5rem 1rem; }
  .list { list-style: none; margin: 0; padding: 0; }
  .filter { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 2rem; }
  .filter button { font: 500 0.9rem/1 var(--font-display); color: var(--fg-soft); background: transparent; border: 1px solid var(--line-strong); border-radius: 999px; padding: 0.5rem 0.85rem; cursor: pointer; transition: all .15s; }
  .filter button span { color: var(--muted); margin-left: 0.2rem; font-variant-numeric: tabular-nums; }
  .filter button:hover { border-color: var(--fg-soft); color: var(--fg); }
  .filter button[aria-pressed='true'] { background: var(--fg); color: var(--ink); border-color: var(--fg); }
  .filter button[aria-pressed='true'] span { color: color-mix(in srgb, var(--ink) 60%, transparent); }
  .empty { color: var(--muted); }
</style>
