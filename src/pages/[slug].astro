---
// Any file in content/pages/ becomes a page: content/pages/about.md → /about
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('pages')).map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <header class="page-head wrap">
    <h1>{page.data.title}</h1>
    {page.data.description && <p>{page.data.description}</p>}
  </header>
  <article class="wrap prose" style="padding-top: 2.5rem"><Content /></article>
</Base>
