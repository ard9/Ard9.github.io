---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Icon from '../../components/Icon.astro';
import FileList from '../../components/FileList.astro';
import AreaTags from '../../components/AreaTags.astro';
import { config } from '../../lib/config';
import { getWriting, formatDate, readingTime, colabUrl, githubUrl, seriesOf, TYPE_LABEL } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await getWriting();
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, newer: all[i - 1], older: all[i + 1] } }));
}
const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, date, updated, type, areas, tags, level, notebook, source, files, series } = entry.data;
const colab = notebook && colabUrl(notebook);
const gh = notebook && !/^https?:/.test(notebook) ? githubUrl(notebook) : undefined;
const parts = await seriesOf(entry);
---
<Base title={title} description={description} type="article">
  <div data-pagefind-body>
  <header class="page-head wrap">
    <a class="crumb" data-pagefind-ignore href="/writing"><Icon name="arrowLeft" />{config.sections.writing.title}</a>
    <AreaTags ids={areas} link />
    <h1>{title}</h1>
    <p>{description}</p>
    <dl class="meta">
      <div><dt>Type</dt><dd>{TYPE_LABEL[type]}</dd></div>
      <div><dt>Published</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
      {updated && <div><dt>Updated</dt><dd><time datetime={updated.toISOString()}>{formatDate(updated)}</time></dd></div>}
      <div><dt>Reading time</dt><dd>{readingTime(entry.body)} min</dd></div>
      {level && <div><dt>Level</dt><dd>{level}</dd></div>}
    </dl>
    {notebook && (
      <div class="btn-row nb">
        {colab && <a class="btn primary" href={colab} target="_blank" rel="noopener"><Icon name="play" />Open in Colab</a>}
        <a class="btn" href={notebook} download><Icon name="download" />Download notebook</a>
        {gh && <a class="btn" href={gh} target="_blank" rel="noopener"><Icon name="github" />View on GitHub</a>}
      </div>
    )}
  </header>

  <div class="wrap layout">
    <article class="prose">
      {source && <p class="source">Adapted from <a href={source.url} target="_blank" rel="noopener">{source.label}</a>.</p>}
      {parts.length > 1 && (
        <nav class="series" aria-label={`Series: ${series}`}>
          <p>Part of the series <strong>{series}</strong></p>
          <ol>{parts.map((p) => <li>{p.id === entry.id ? <span aria-current="page">{p.data.title}</span> : <a href={`/writing/${p.id}`}>{p.data.title}</a>}</li>)}</ol>
        </nav>
      )}
      <Content />
      {files.length > 0 && (<><h2>Files</h2><FileList files={files} /></>)}
      {tags.length > 0 && <ul class="tags end">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    </article>
    <aside data-pagefind-ignore><Toc headings={headings} /></aside>
  </div>
  </div>

  {(newer || older) && (
    <nav class="wrap pager" aria-label="More writing">
      {older ? <a href={`/writing/${older.id}`}><span><Icon name="arrowLeft" />Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="next" href={`/writing/${newer.id}`}><span>Newer<Icon name="arrowRight" /></span>{newer.data.title}</a>}
    </nav>
  )}
</Base>

<style>
  .page-head :global(.areas-inline) { margin-bottom: 1.1rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 2.25rem; margin: 2rem 0 0; }
  .meta dt { font-size: 0.82rem; color: var(--muted); }
  .meta dd { margin: 0.15rem 0 0; }
  .nb { margin-top: 2rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: clamp(2rem, 6vw, 5rem); padding-top: clamp(2rem, 5vw, 3rem); align-items: start; }
  aside { position: sticky; top: calc(var(--head-h) + 1.5rem); }
  .source { font-size: 0.95rem; color: var(--muted); padding: 0.8rem 1rem; border: 1px dashed var(--line-strong); border-radius: var(--radius-s); }
  .series { font-size: 0.95rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--surface); }
  .series p { margin: 0 0 0.5rem; color: var(--muted); }
  .series ol { margin: 0; padding-left: 1.3em; }
  .series [aria-current] { color: var(--fg); font-weight: 600; }
  .end { margin-top: 3rem; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; }
  .pager a { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.2rem 1.3rem; border: 1px solid var(--line); border-radius: var(--radius-m); text-decoration: none; font-family: var(--font-display); font-weight: 500; }
  .pager a:hover { border-color: var(--fg-soft); }
  .pager a span { display: flex; align-items: center; gap: 0.4rem; color: var(--muted); font-size: 0.85rem; font-weight: 400; }
  .pager .next { text-align: right; align-items: flex-end; }
  @media (max-width: 60rem) { .layout { grid-template-columns: 1fr; } aside { display: none; } }
  @media (max-width: 36rem) { .pager { grid-template-columns: 1fr; } }
</style>
