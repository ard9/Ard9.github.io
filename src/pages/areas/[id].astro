---
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import WritingRow from '../../components/WritingRow.astro';
import Icon from '../../components/Icon.astro';
import { config, resume } from '../../lib/config';
import { getProjects, getWriting } from '../../lib/utils';

export function getStaticPaths() {
  return config.areas.map((area) => ({ params: { id: area.id }, props: { area } }));
}
const { area } = Astro.props;
const projects = (await getProjects()).filter((p) => p.data.areas.includes(area.id));
const writing = (await getWriting()).filter((w) => w.data.areas.includes(area.id));
const skills = resume.skills.filter((s) => s.area === area.id);
const others = config.areas.filter((a) => a.id !== area.id);
---
<Base title={area.name} description={area.intro ?? area.short}>
  <header class="page-head wrap head" style={`--c: var(--area-${area.id})`}>
    <a class="crumb" href="/areas"><Icon name="arrowLeft" />{config.sections.areas.title}</a>
    <h1>{area.name}</h1>
    <p>{area.intro ?? area.short}</p>
    {skills.length > 0 && (
      <dl class="skills">
        {skills.map((s) => <div><dt>{s.group}</dt><dd><ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul></dd></div>)}
      </dl>
    )}
  </header>

  <div class="wrap">
    <section class="section">
      <div class="section-head"><h2>Projects</h2>{projects.length > 0 && <a href={`/projects?area=${area.id}`}>Open in Work</a>}</div>
      {projects.length ? <ul class="list">{projects.map((p) => <ProjectRow project={p} />)}</ul> : <p class="empty">No projects in this area yet.</p>}
    </section>
    <section class="section">
      <div class="section-head"><h2>Writing</h2>{writing.length > 0 && <a href={`/writing?area=${area.id}`}>Open in Writing</a>}</div>
      {writing.length ? <ul class="list">{writing.map((w) => <WritingRow entry={w} />)}</ul> : <p class="empty">No writing in this area yet.</p>}
    </section>
    <nav class="others" aria-label="Other areas">
      {others.map((a) => <a class="area" href={`/areas/${a.id}`} style={`--c: var(--area-${a.id})`}>{a.name}</a>)}
    </nav>
  </div>
</Base>
<style>
  .head { position: relative; }
  .head h1 { display: flex; align-items: center; gap: 1rem; }
  .head h1::before { content: ''; width: 0.55em; height: 0.55em; border-radius: 6px; background: var(--c); flex: none; }
  .skills { margin: 2rem 0 0; display: grid; gap: 0.7rem; }
  .skills > div { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; align-items: baseline; }
  .skills dt { color: var(--muted); font-size: 0.92rem; }
  .skills dd { margin: 0; }
  .others { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; padding-top: 1rem; border-top: 1px solid var(--line); padding-block: 2rem 0; }
  .others .area { font-size: 1rem; }
  @media (max-width: 40rem) { .skills > div { grid-template-columns: 1fr; gap: 0.35rem; } }
</style>
