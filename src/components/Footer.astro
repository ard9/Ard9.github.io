---
import { config } from '../lib/config';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap">
    <p>© {year} {config.author.name}. {config.footer.note}</p>
    <ul class="socials">
      {config.socials.map((s) => (
        <li><a href={s.url} aria-label={s.label} title={s.label} rel="me noopener" target={s.url.startsWith('mailto:') ? undefined : '_blank'}><Icon name={s.icon} /></a></li>
      ))}
    </ul>
  </div>
</footer>
<style>
  .socials { display: flex; gap: 0.35rem; list-style: none; margin: 0; padding: 0; }
  .socials a { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; color: var(--muted); border: 1px solid var(--line); }
  .socials a:hover { color: var(--accent); border-color: var(--accent); }
</style>
