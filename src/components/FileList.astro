---
import { fileSize, fileExt } from '../lib/utils';
import Icon from './Icon.astro';
interface Props { files: { label: string; path: string; note?: string }[] }
const { files } = Astro.props;
---
{files.length > 0 && (
  <ul class="files">
    {files.map((f) => {
      const size = fileSize(f.path);
      const external = /^https?:/.test(f.path);
      return (
        <li>
          <a href={f.path} download={external ? undefined : ''} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
            <span class="ext">{external ? 'LINK' : fileExt(f.path)}</span>
            <span class="name">
              {f.label}
              {(f.note || size) && <small>{f.note}{f.note && size && ', '}{size && <span class="size">{size}</span>}</small>}
            </span>
            <Icon name={external ? 'external' : 'download'} />
          </a>
        </li>
      );
    })}
  </ul>
)}
<style>
  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  a { display: grid; grid-template-columns: 3.4rem 1fr auto; align-items: center; gap: 0.85rem; padding: 0.7rem 0.85rem; border: 1px solid var(--line); border-radius: var(--radius-s); text-decoration: none; background: var(--ink-raised); transition: border-color .15s; }
  a:hover { border-color: var(--accent); color: var(--fg); }
  a:hover svg { color: var(--accent); }
  .ext { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em; color: var(--ink); background: var(--fg-soft); border-radius: 4px; padding: 0.3rem 0; text-align: center; }
  .name { display: flex; flex-direction: column; font-weight: 500; line-height: 1.3; min-width: 0; overflow-wrap: anywhere; }
  small { color: var(--muted); font-weight: 400; font-size: 0.82rem; margin-top: 0.15rem; }
  svg { color: var(--muted); }
  .size { white-space: nowrap; }
</style>
