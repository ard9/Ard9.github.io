---
// The hero waveform: a deterministic, speech-shaped signal (seeded by `seed`).
// A playhead reveals it once on load; afterwards it reacts to the pointer.
interface Props { seed?: string; label?: string }
const { seed = 'voice', label = 'Decorative audio waveform' } = Astro.props;
---
<div class="wave" data-seed={seed}>
  <canvas role="img" aria-label={label}></canvas>
</div>

<style>
  .wave { position: relative; height: clamp(110px, 16vw, 170px); margin-block: clamp(2rem, 5vw, 3.25rem); }
  canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; }
</style>

<script>
  function hash(s: string) { let h = 2166136261; for (const c of s) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; }
  function rng(seed: number) { return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

  // Speech-like amplitude: words made of syllables, with pauses between words.
  function envelope(n: number, rand: () => number) {
    const env = new Float32Array(n);
    let x = 0.02;
    while (x < 0.98) {
      const syllables = 1 + Math.floor(rand() * 4);
      for (let s = 0; s < syllables && x < 0.98; s++) {
        const w = 0.012 + rand() * 0.022, a = 0.35 + rand() * 0.65, c = x + w;
        for (let i = 0; i < n; i++) { const d = (i / n - c) / w; env[i] += a * Math.exp(-d * d * 1.6); }
        x += w * (1.6 + rand() * 0.8);
      }
      x += 0.02 + rand() * 0.05; // pause between words
    }
    for (let i = 0; i < n; i++) env[i] = Math.min(1, env[i]) * (0.82 + rand() * 0.18);
    return env;
  }

  for (const host of document.querySelectorAll<HTMLElement>('.wave')) {
    const canvas = host.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const css = getComputedStyle(document.documentElement);
    const c1 = css.getPropertyValue('--accent-2').trim() || '#E0507A';
    const c2 = css.getPropertyValue('--accent').trim() || '#FBB061';
    const dim = css.getPropertyValue('--line-strong').trim() || '#3E3558';
    const seed = hash(host.dataset.seed || 'voice');

    let w = 0, h = 0, bars = 0, env = new Float32Array(0), level = new Float32Array(0);
    let pointer = -1, start = performance.now(), raf = 0, visible = true;
    const REVEAL = 1700, BAR = 3, GAP = 3;

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = host.clientWidth; h = host.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.floor(w / (BAR + GAP));
      if (n !== bars) { bars = n; env = envelope(n, rng(seed)); level = new Float32Array(n); }
    }

    function draw(t: number) {
      const p = reduce ? 1 : Math.min(1, (t - start) / REVEAL);
      const eased = 1 - Math.pow(1 - p, 3);
      const head = eased * bars;
      const grad = ctx.createLinearGradient(0, 0, w, 0);
      grad.addColorStop(0, c1); grad.addColorStop(1, c2);
      ctx.clearRect(0, 0, w, h);
      const mid = h / 2;
      for (let i = 0; i < bars; i++) {
        const near = pointer < 0 ? 0 : Math.exp(-(((i - pointer) / 9) ** 2));
        const breathe = reduce ? 0 : 0.06 * Math.sin(t / 650 + i * 0.35) * env[i];
        const target = i < head ? env[i] * (1 + 0.35 * near) + breathe : 0.02;
        level[i] += (target - level[i]) * (reduce ? 1 : 0.18);
        const bh = Math.max(2, level[i] * (h - 8));
        const x = i * (BAR + GAP);
        ctx.globalAlpha = i < head ? 0.55 + 0.45 * Math.max(near, env[i] > 0.15 ? 0.6 : 0) : 1;
        ctx.fillStyle = i < head ? grad : dim;
        ctx.beginPath();
        ctx.roundRect(x, mid - bh / 2, BAR, bh, 1.5);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (p < 1) { // playhead
        const x = head * (BAR + GAP);
        ctx.fillStyle = c2; ctx.fillRect(x, 4, 1.5, h - 8);
      }
      if (!reduce && visible) raf = requestAnimationFrame(draw);
    }

    resize();
    new ResizeObserver(() => { resize(); if (reduce) draw(performance.now()); }).observe(host);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }
    }).observe(host);
    host.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); pointer = (e.clientX - r.left) / (BAR + GAP); });
    host.addEventListener('pointerleave', () => { pointer = -1; });
    draw(performance.now());
  }
</script>
