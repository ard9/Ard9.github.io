---
// Use inside .mdx files:  <AudioClip src="/files/sample.wav" caption="Narrowband version" />
interface Props { src: string; caption?: string }
const { src, caption } = Astro.props;
---
<figure class="clip">
  <audio controls preload="none" src={src}></audio>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .clip { margin-inline: 0; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); }
  audio { width: 100%; display: block; }
  figcaption { margin-top: 0.5rem; }
</style>
