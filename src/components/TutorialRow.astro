---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/utils';
import Icon from './Icon.astro';
interface Props { tutorial: CollectionEntry<'tutorials'>; showTopic?: boolean }
const { tutorial, showTopic = true } = Astro.props;
const { title, description, date, topic, level, notebook } = tutorial.data;
---
<li class="row">
  <a href={`/tutorials/${tutorial.id}`}>
    <div class="body">
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
    <dl class="meta">
      {showTopic && <div><dt class="visually-hidden">Topic</dt><dd class="topic">{topic}</dd></div>}
      <div><dt class="visually-hidden">Published</dt><dd><time datetime={date.toISOString()}>{formatDate(date, 'short')}</time></dd></div>
      <div><dt class="visually-hidden">Length</dt><dd>{readingTime(tutorial.body)} min read</dd></div>
      {level && <div><dt class="visually-hidden">Level</dt><dd>{level}</dd></div>}
      {notebook && <div><dt class="visually-hidden">Includes</dt><dd class="nb"><Icon name="notebook" /> Notebook</dd></div>}
    </dl>
  </a>
</li>
<style>
  .row { border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  a { display: grid; grid-template-columns: 1fr 13rem; gap: 2rem; padding: 1.5rem 0.75rem; margin-inline: -0.75rem; text-decoration: none; border-radius: var(--radius-s); transition: background .2s; }
  a:hover { background: var(--surface); color: inherit; }
  a:hover h3 { color: var(--accent); }
  h3 { font-size: 1.3rem; font-weight: 600; transition: color .15s; }
  p { margin: 0.4rem 0 0; color: var(--fg-soft); max-width: 62ch; }
  .meta { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.9rem; color: var(--muted); padding-top: 0.2rem; }
  dd { margin: 0; display: flex; align-items: center; gap: 0.35rem; }
  .topic { color: var(--accent); }
  .nb svg { width: 15px; height: 15px; }
  @media (max-width: 40rem) {
    a { grid-template-columns: 1fr; gap: 0.8rem; }
    .meta { flex-direction: row; flex-wrap: wrap; column-gap: 1rem; }
  }
</style>
