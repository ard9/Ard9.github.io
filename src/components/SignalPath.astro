---
// Home-page hero visual. Left to right: image patches and an audio waveform become
// tokens, tokens flow into a graph of agents, and an infrastructure rail runs underneath.
// Each part is linked to the area whose `visual` matches it in config/site.yaml.
import { config } from '../lib/config';
import { areaStats } from '../lib/utils';

const ORDER = ['patches', 'wave', 'graph', 'rail'] as const;
const stats = await areaStats();
const areas = [...config.areas].sort((a, b) =>
  (a.visual ? ORDER.indexOf(a.visual) : 9) - (b.visual ? ORDER.indexOf(b.visual) : 9));
const visuals = Object.fromEntries(config.areas.filter((a) => a.visual).map((a) => [a.visual, a.id]));
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
---
<div class="signal" data-visuals={JSON.stringify(visuals)} data-seed={config.author.name}>
  <canvas role="img" aria-label="Animated diagram: image patches and an audio waveform turn into tokens, which feed a graph of AI agents, all running on an infrastructure layer."></canvas>
</div>
<ul class="legend">
  {areas.map((a) => {
    const s = stats.get(a.id)!;
    const counts = [s.projects && plural(s.projects, 'project'), s.writing && plural(s.writing, 'article')].filter(Boolean).join(', ');
    return (
      <li>
        <a href={`/areas/${a.id}`} data-area={a.id} data-visual={a.visual ?? ''} style={`--c: var(--area-${a.id})`}>
          <span class="name">{a.name}</span>
          <span class="short">{a.short}</span>
          {counts && <span class="count">{counts}</span>}
        </a>
      </li>
    );
  })}
</ul>

<style>
  .signal { position: relative; height: clamp(150px, 19vw, 220px); margin-top: clamp(2.5rem, 6vw, 4rem); }
  canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; }
  .legend { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .legend a {
    display: flex; flex-direction: column; gap: 0.2rem; height: 100%;
    padding: 0.9rem 1rem 1rem; border-radius: var(--radius-s); text-decoration: none;
    border-top: 2px solid var(--c); background: color-mix(in srgb, var(--c) 6%, transparent);
    transition: background .2s, opacity .2s;
  }
  .legend a:hover, .legend a.on { background: color-mix(in srgb, var(--c) 14%, transparent); }
  .legend.dim a:not(.on) { opacity: 0.5; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--fg); }
  .short { color: var(--fg-soft); font-size: 0.9rem; line-height: 1.4; }
  .count { color: var(--muted); font-size: 0.82rem; margin-top: auto; padding-top: 0.5rem; }
  @media (max-width: 52rem) { .legend { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 26rem) { .legend { grid-template-columns: 1fr; } }
</style>

<script>
  type Seg = 'patches' | 'wave' | 'tokens' | 'graph' | 'rail';
  const host = document.querySelector<HTMLElement>('.signal');
  if (host) {
    const canvas = host.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const legend = document.querySelector<HTMLElement>('.legend')!;
    const visuals: Record<string, string> = JSON.parse(host.dataset.visuals || '{}');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── deterministic randomness ──
    let h0 = 2166136261; for (const c of host.dataset.seed || 'x') { h0 ^= c.charCodeAt(0); h0 = Math.imul(h0, 16777619); }
    const rng = (seed: number) => () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };

    // ── colours (re-read when the theme changes) ──
    let col: Record<string, string> = {};
    function readColours() {
      const cs = getComputedStyle(document.documentElement);
      const area = (v: string) => (visuals[v] && cs.getPropertyValue(`--area-${visuals[v]}`).trim()) || cs.getPropertyValue('--muted').trim();
      col = { patches: area('patches'), wave: area('wave'), graph: area('graph'), rail: area('rail'),
              fg: cs.getPropertyValue('--fg').trim(), line: cs.getPropertyValue('--line-strong').trim() };
    }

    // ── geometry ──
    let w = 0, h = 0;
    const R = { patches: [0, 0.13], wave: [0.155, 0.47], tokens: [0.495, 0.63], graph: [0.66, 1] } as const;
    let patches: { x: number; y: number; s: number; v: number }[] = [];
    let env = new Float32Array(0), level = new Float32Array(0), waveX0 = 0;
    let tokens: { x: number; y: number; w: number; h: number; v: number }[] = [];
    let nodes: { x: number; y: number; r: number }[] = [], edges: [number, number][] = [];
    let pulses: { e: number; t: number; speed: number }[] = [];
    const BAR = 3, GAP = 3;

    function layout() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = host!.clientWidth; h = host!.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const r = rng(h0), body = h - 22, mid = body / 2;

      // patches: a small image cut into squares
      patches = [];
      const pw = (R.patches[1] - R.patches[0]) * w, rows = 4, cols = 4;
      const s = Math.min(pw / cols, (body * 0.78) / rows) - 4;
      const gx = R.patches[0] * w + (pw - cols * (s + 4)) / 2, gy = mid - (rows * (s + 4)) / 2;
      for (let i = 0; i < rows; i++) for (let j = 0; j < cols; j++) {
        const cx = (j - 1.5) / 2, cy = (i - 1.5) / 2;
        patches.push({ x: gx + j * (s + 4), y: gy + i * (s + 4), s, v: 0.25 + 0.75 * Math.max(0, 1 - Math.hypot(cx, cy) * 0.7) * (0.6 + 0.4 * r()) });
      }

      // waveform: words made of syllables
      waveX0 = R.wave[0] * w;
      const n = Math.floor(((R.wave[1] - R.wave[0]) * w) / (BAR + GAP));
      env = new Float32Array(n); level = new Float32Array(n);
      let x = 0.03;
      while (x < 0.97) {
        const syl = 1 + Math.floor(r() * 3);
        for (let k = 0; k < syl && x < 0.97; k++) {
          const sw = 0.02 + r() * 0.035, a = 0.35 + r() * 0.65, c = x + sw;
          for (let i = 0; i < n; i++) { const d = (i / n - c) / sw; env[i] += a * Math.exp(-d * d * 1.6); }
          x += sw * (1.6 + r() * 0.8);
        }
        x += 0.03 + r() * 0.07;
      }
      for (let i = 0; i < n; i++) env[i] = Math.min(1, env[i]) * (0.8 + r() * 0.2);

      // tokens: a short sequence of discrete blocks, three rows
      tokens = [];
      const tx0 = R.tokens[0] * w, tx1 = R.tokens[1] * w, tw = 13, tg = 4, th = Math.min(20, body / 6);
      const per = Math.max(3, Math.floor((tx1 - tx0) / (tw + tg)));
      for (let row = 0; row < 3; row++) for (let i = 0; i < per; i++)
        tokens.push({ x: tx0 + i * (tw + tg), y: mid + (row - 1.5) * (th + 6) + 3, w: tw, h: th, v: 0.35 + r() * 0.65 });

      // graph: columns of agents and tools
      nodes = []; edges = [];
      const cols2 = [3, 2, 3, 1], gx0 = R.graph[0] * w + 14, gx1 = R.graph[1] * w - 14;
      const starts: number[] = [];
      cols2.forEach((count, ci) => {
        starts.push(nodes.length);
        const cx = gx0 + (gx1 - gx0) * (ci / (cols2.length - 1));
        for (let k = 0; k < count; k++) {
          const cy = count === 1 ? mid : body * 0.14 + (body * 0.72) * (k / (count - 1));
          nodes.push({ x: cx, y: cy, r: ci === cols2.length - 1 ? 7 : 4.5 });
        }
      });
      for (let ci = 0; ci < cols2.length - 1; ci++) {
        for (let a = 0; a < cols2[ci]; a++) {
          let linked = false;
          for (let b = 0; b < cols2[ci + 1]; b++)
            if (r() < 0.62 || (!linked && b === cols2[ci + 1] - 1)) { edges.push([starts[ci] + a, starts[ci + 1] + b]); linked = true; }
        }
      }
      pulses = Array.from({ length: Math.min(7, edges.length) }, () => ({ e: Math.floor(r() * edges.length), t: r(), speed: 0.004 + r() * 0.004 }));
    }

    // ── interaction state ──
    let hover: Seg | null = null;
    const alpha: Record<Seg, number> = { patches: 1, wave: 1, tokens: 1, graph: 1, rail: 1 };
    function segAt(x: number, y: number): Seg | null {
      if (y > h - 24) return 'rail';
      const f = x / w;
      if (f < R.patches[1] + 0.012) return 'patches';
      if (f < R.wave[1] + 0.012) return 'wave';
      if (f < R.tokens[1] + 0.015) return 'tokens';
      return 'graph';
    }
    function setHover(seg: Seg | null) {
      if (seg === 'tokens' || (seg && !visuals[seg])) seg = null;
      hover = seg;
      canvas.style.cursor = seg ? 'pointer' : 'default';
      legend.classList.toggle('dim', !!seg);
      legend.querySelectorAll<HTMLElement>('a').forEach((a) => a.classList.toggle('on', !!seg && a.dataset.visual === seg));
      if (reduce) frame(performance.now());
    }

    // ── drawing ──
    const start = performance.now(); let raf = 0, running = true;
    const REVEAL = 1900;

    function frame(t: number) {
      const p = reduce ? 1 : Math.min(1, (t - start) / REVEAL);
      const sweep = (1 - Math.pow(1 - p, 3)) * w;
      for (const k of Object.keys(alpha) as Seg[]) {
        const target = !hover ? 1 : k === hover ? 1 : 0.16;
        alpha[k] += (target - alpha[k]) * (reduce ? 1 : 0.15);
      }
      ctx.clearRect(0, 0, w, h);
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, sweep, h); ctx.clip();
      const body = h - 22, mid = body / 2;

      // patches
      ctx.fillStyle = col.patches;
      for (const q of patches) {
        const shimmer = reduce ? 0 : 0.08 * Math.sin(t / 900 + q.x * 0.05 + q.y * 0.03);
        ctx.globalAlpha = alpha.patches * Math.max(0.12, q.v + shimmer);
        ctx.beginPath(); ctx.roundRect(q.x, q.y, q.s, q.s, 3); ctx.fill();
      }

      // waveform
      ctx.fillStyle = col.wave;
      for (let i = 0; i < env.length; i++) {
        const breathe = reduce ? 0 : 0.07 * Math.sin(t / 600 + i * 0.33) * env[i];
        const lift = hover === 'wave' ? 0.12 * env[i] : 0;
        level[i] += (env[i] + breathe + lift - level[i]) * (reduce ? 1 : 0.2);
        const bh = Math.max(2, level[i] * body * 0.92);
        ctx.globalAlpha = alpha.wave * (0.5 + 0.5 * env[i]);
        ctx.beginPath(); ctx.roundRect(waveX0 + i * (BAR + GAP), mid - bh / 2, BAR, bh, 1.5); ctx.fill();
      }

      // tokens: tinted from the inputs' colour to the agents' colour
      const tx0 = R.tokens[0] * w, tx1 = R.tokens[1] * w;
      const grad = ctx.createLinearGradient(tx0, 0, tx1, 0);
      grad.addColorStop(0, col.wave); grad.addColorStop(1, col.graph);
      ctx.fillStyle = grad;
      const scan = reduce ? -1 : ((t / 1400) % 1.6) - 0.3;
      for (const k of tokens) {
        const f = (k.x - tx0) / (tx1 - tx0);
        const glow = scan < 0 ? 0 : Math.max(0, 1 - Math.abs(f - scan) * 6) * 0.5;
        ctx.globalAlpha = alpha.tokens * Math.min(1, k.v * 0.65 + glow);
        ctx.beginPath(); ctx.roundRect(k.x, k.y, k.w, k.h, 3); ctx.fill();
      }

      // graph edges, pulses, nodes
      ctx.strokeStyle = col.graph; ctx.lineWidth = 1.2;
      const bez = (a: typeof nodes[0], b: typeof nodes[0], s: number) => {
        const mx = (a.x + b.x) / 2, u = 1 - s;
        return { x: u*u*u*a.x + 3*u*u*s*mx + 3*u*s*s*mx + s*s*s*b.x, y: u*u*u*a.y + 3*u*u*s*a.y + 3*u*s*s*b.y + s*s*s*b.y };
      };
      ctx.globalAlpha = alpha.graph * 0.4;
      for (const [i, j] of edges) {
        const a = nodes[i], b = nodes[j], mx = (a.x + b.x) / 2;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.bezierCurveTo(mx, a.y, mx, b.y, b.x, b.y); ctx.stroke();
      }
      // links from the token sequence into the first agents
      ctx.globalAlpha = alpha.graph * 0.22; ctx.setLineDash([2, 4]);
      for (const n of nodes.slice(0, 3)) { ctx.beginPath(); ctx.moveTo(tx1 + 6, mid); ctx.bezierCurveTo((tx1 + n.x) / 2, mid, (tx1 + n.x) / 2, n.y, n.x, n.y); ctx.stroke(); }
      ctx.setLineDash([]);
      ctx.fillStyle = col.graph;
      if (!reduce) for (const pl of pulses) {
        pl.t += pl.speed * (hover === 'graph' ? 2 : 1);
        if (pl.t >= 1) { pl.t = 0; pl.e = Math.floor(Math.random() * edges.length); }
        const [i, j] = edges[pl.e]; const pt = bez(nodes[i], nodes[j], pl.t);
        ctx.globalAlpha = alpha.graph * Math.sin(pl.t * Math.PI);
        ctx.beginPath(); ctx.arc(pt.x, pt.y, 2.4, 0, Math.PI * 2); ctx.fill();
      }
      for (const n of nodes) {
        ctx.globalAlpha = alpha.graph;
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = alpha.graph * 0.18;
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r + 5, 0, Math.PI * 2); ctx.fill();
      }

      // infrastructure rail with traffic flowing through it
      const ry = h - 6;
      ctx.globalAlpha = alpha.rail * 0.35; ctx.fillStyle = col.rail;
      ctx.fillRect(0, ry - 0.5, w, 1);
      ctx.globalAlpha = alpha.rail;
      const off = reduce ? 0 : (t * (hover === 'rail' ? 0.12 : 0.05)) % 56;
      for (let x = -56 + off; x < w; x += 56) { ctx.beginPath(); ctx.roundRect(x, ry - 2, 20, 4, 2); ctx.fill(); }
      ctx.globalAlpha = alpha.rail * 0.5;
      for (let x = 28; x < w; x += 112) ctx.fillRect(x, ry - 9, 1, 6);

      ctx.restore(); ctx.globalAlpha = 1;
      if (p < 1) { ctx.fillStyle = col.fg; ctx.fillRect(sweep, 0, 1.5, h); }
      if (!reduce && running) raf = requestAnimationFrame(frame);
    }

    readColours(); layout();
    new ResizeObserver(() => { layout(); if (reduce) frame(performance.now()); }).observe(host);
    new MutationObserver(() => { readColours(); if (reduce) frame(performance.now()); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new IntersectionObserver(([e]) => {
      running = e.isIntersecting;
      if (running && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
    }).observe(host);

    host.addEventListener('pointermove', (e) => {
      const b = canvas.getBoundingClientRect(); const seg = segAt(e.clientX - b.left, e.clientY - b.top);
      if (seg !== hover) setHover(seg);
    });
    host.addEventListener('pointerleave', () => setHover(null));
    host.addEventListener('click', () => { if (hover && visuals[hover]) location.href = `/areas/${visuals[hover]}`; });
    legend.querySelectorAll<HTMLElement>('a').forEach((a) => {
      a.addEventListener('pointerenter', () => setHover((a.dataset.visual || null) as Seg | null));
      a.addEventListener('pointerleave', () => setHover(null));
      a.addEventListener('focus', () => setHover((a.dataset.visual || null) as Seg | null));
      a.addEventListener('blur', () => setHover(null));
    });
    frame(performance.now());
  }
</script>
