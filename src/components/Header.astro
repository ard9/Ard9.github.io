---
import { config } from '../lib/config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/' && (path === href || path.startsWith(href + '/'));
---
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${config.author.name}, home`}>
      <svg viewBox="0 0 28 20" aria-hidden="true"><path d="M1 10h3l2-5 3 10 3-14 3 18 3-12 2 6 2-3h5" /></svg>
      <span>{config.author.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {config.nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky; top: 0; z-index: 20;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .brand svg { width: 28px; height: 20px; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .brand:hover { color: var(--fg); }
  .brand:hover svg { stroke: var(--accent-2); }
  ul { display: flex; gap: clamp(0.25rem, 2vw, 1.25rem); list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 0.45rem 0.55rem; text-decoration: none; color: var(--fg-soft); border-radius: var(--radius-s); font-size: 0.98rem; }
  nav a:hover { color: var(--fg); background: var(--ink-raised); }
  nav a[aria-current='page'] { color: var(--accent); }
  @media (max-width: 21rem) { .brand span { display: none; } }
</style>
