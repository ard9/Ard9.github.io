---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { config } from '../lib/config';
import { resolveFonts } from '../lib/fonts';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article' }
const { title, description = config.site.description, image = config.author.photo, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${config.site.title}` : `${config.site.title}, ${config.author.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const fonts = resolveFonts();
// :root:root wins over the defaults in global.css regardless of stylesheet order
const themeVars = `:root:root{--accent:${config.theme.accent};--accent-2:${config.theme.accent_2};${fonts.vars}}`;
---
<!doctype html>
<html lang={config.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#130F1D" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {fonts.googleHref && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts.googleHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts.googleHref && <link rel="stylesheet" href={fonts.googleHref} />}
    <style set:html={themeVars}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
